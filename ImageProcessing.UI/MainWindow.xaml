<Window x:Class="SIOVI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:scottPlot="clr-namespace:ScottPlot.WPF;assembly=ScottPlot.WPF"
        Title="Обработка изображений" Width="1280" Height="800"
        MinWidth="1000" MinHeight="650" WindowStartupLocation="CenterScreen">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="320" />
        </Grid.ColumnDefinitions>

        <Grid Margin="0,0,12,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <GroupBox Header="Исходное изображение" Margin="0,0,6,6" Padding="8">
                <Grid>
                    <Image x:Name="OriginalImage" Stretch="Uniform" />
                </Grid>
            </GroupBox>
            <GroupBox Grid.Column="1" Header="Гистограмма исходного изображения"
                      Margin="6,0,0,6" Padding="4">
                <scottPlot:WpfPlot x:Name="OriginalHistogram" />
            </GroupBox>
            <GroupBox Grid.Row="1" Header="Результат обработки" Margin="0,6,6,0" Padding="8">
                <Grid>
                    <Image x:Name="ProcessedImage" Stretch="Uniform" />
                </Grid>
            </GroupBox>
            <GroupBox Grid.Row="1" Grid.Column="1" Header="Гистограмма результата"
                      Margin="6,6,0,0" Padding="4">
                <scottPlot:WpfPlot x:Name="ProcessedHistogram" />
            </GroupBox>
        </Grid>

        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel x:Name="ControlsPanel">
                <GroupBox Header="Изображение" Padding="10" Margin="0,0,0,12">
                    <StackPanel>
                        <Button x:Name="OpenImageButton" Content="Выбрать изображение" Padding="8,5"
                                Click="OpenImage_Click" />
                        <TextBlock x:Name="FileNameText" Text="Файл не выбран" Margin="0,8,0,0"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="Алгоритм" Padding="10" Margin="0,0,0,12">
                    <StackPanel>
                        <Label Content="Выберите алгоритм:" Target="{Binding ElementName=AlgorithmSelector}"
                               Padding="0,0,0,6" />
                        <ComboBox x:Name="AlgorithmSelector" DisplayMemberPath="Name"
                                  SelectionChanged="AlgorithmSelector_SelectionChanged" />
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="Параметры" Padding="10" Margin="0,0,0,12">
                    <StackPanel>
                        <ItemsControl x:Name="ParametersList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,0,0,10">
                                        <Label Content="{Binding Name}" Target="{Binding ElementName=ParameterInput}"
                                               Padding="0,0,0,4" />
                                        <TextBox x:Name="ParameterInput" Padding="4,3"
                                                 Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                                                 TextChanged="ParameterInput_TextChanged" />
                                        <TextBlock Text="{Binding Hint}" TextWrapping="Wrap" Margin="0,4,0,0" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock x:Name="NoParametersText" Text="У этого алгоритма нет параметров."
                                   TextWrapping="Wrap" Visibility="Collapsed" />
                    </StackPanel>
                </GroupBox>

                <Button x:Name="ApplyButton" Content="Применить" Padding="8,6" IsEnabled="False"
                        Click="Apply_Click" />
                <TextBlock x:Name="ErrorText" Foreground="DarkRed" TextWrapping="Wrap" Margin="0,8,0,0" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>